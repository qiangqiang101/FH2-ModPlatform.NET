<Project>
  <!--
    FH2ModType: your Mod class, with its namespace ("MyMod.MyMod"). From it the
    build writes FH2ModEntry.g.cs (FH2ModEntry.g.vb in a VB.NET project), which holds
      [assembly: ModEntry(typeof(...))]   how FH2DotNet.dll finds the class
      fh2mod_init                         the export a NativeAOT DLL needs
    so the same project works both ways.

    FH2ModsDir (optional): the game's fh2-mods folder. Set it (in a
    Directory.Build.props or Directory.Build.targets, or with -p:) and builds
    are copied there: a hosted build to fh2-mods-dotnet\<Name>\ next to it
    (FH2DotNetModsDir to put them elsewhere), an AOT publish to
    fh2-mods itself.
  -->
  <Target Name="FH2GenerateModEntry" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(FH2ModType)' != ''">
    <!-- Worked out here, when the build runs: a project that imports this file itself (rather
         than through a package or Directory.Build.targets) reads it before the SDK has set
         IntermediateOutputPath and Language. -->
    <PropertyGroup>
      <_FH2EntryExt Condition="'$(Language)' == 'VB'">vb</_FH2EntryExt>
      <_FH2EntryExt Condition="'$(_FH2EntryExt)' == ''">cs</_FH2EntryExt>
      <FH2ModEntryFile>$(IntermediateOutputPath)FH2ModEntry.g.$(_FH2EntryExt)</FH2ModEntryFile>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Language)' != 'VB'">
      <_FH2EntryCode><![CDATA[// <auto-generated>FH2ModPlatform build: from <FH2ModType>$(FH2ModType)</FH2ModType>.</auto-generated>
[assembly: global::FH2ModPlatform.ModEntryAttribute(typeof(global::$(FH2ModType)))]

namespace FH2ModPlatform.Generated
{
    internal static unsafe class FH2ModExports
    {
        // NativeAOT exports this as the DLL's fh2mod_init. On a hosted build it's never called.
        [global::System.Runtime.InteropServices.UnmanagedCallersOnly(EntryPoint = "fh2mod_init")]
        private static int Init(global::FH2ModPlatform.Native.FH2ModApi* api) =>
            global::FH2ModPlatform.ModLoader.InitNative<global::$(FH2ModType)>(api);
    }
}
]]></_FH2EntryCode>
    </PropertyGroup>
    <!-- VB.NET: FH2ModType is the full name, root namespace included ("CarSpawner.CarSpawnerMod"). -->
    <PropertyGroup Condition="'$(Language)' == 'VB'">
      <_FH2EntryCode><![CDATA[' <auto-generated>FH2ModPlatform build: from <FH2ModType>$(FH2ModType)</FH2ModType>.</auto-generated>
<Assembly: Global.FH2ModPlatform.ModEntryAttribute(GetType(Global.$(FH2ModType)))>

' fh2mod_init comes from the SDK (VB.NET can't declare [UnmanagedCallersOnly]): NativeExport in the SDK's ModLoader.cs.
]]></_FH2EntryCode>
    </PropertyGroup>
    <WriteLinesToFile File="$(FH2ModEntryFile)" Lines="$([MSBuild]::Escape($(_FH2EntryCode)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(FH2ModEntryFile)" />
      <FileWrites Include="$(FH2ModEntryFile)" />
    </ItemGroup>
  </Target>

  <!-- VB.NET NativeAOT: fh2mod_init is the SDK's own (NativeExport), told the mod's assembly by name. -->
  <ItemGroup Condition="'$(Language)' == 'VB' and '$(FH2ModHosting)' == 'Aot'">
    <UnmanagedEntryPointsAssembly Include="FH2ModPlatform" />
    <RuntimeHostConfigurationOption Include="FH2ModPlatform.ModAssembly" Value="$(AssemblyName)" />
    <!-- Keeps the mod assembly loadable by name, with its [assembly: ModEntry]. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />
  </ItemGroup>

  <Target Name="FH2CheckModType" BeforeTargets="BeforeBuild" Condition="'$(FH2ModType)' == ''">
    <Warning Text="Set &lt;FH2ModType&gt; to your Mod class (Namespace.Class), or this project has no fh2mod_init and FH2DotNet.dll can't start it." />
  </Target>

  <Target Name="FH2DeployHosted" AfterTargets="Build" Condition="'$(FH2ModsDir)' != '' and '$(FH2ModHosting)' == 'Hosted'">
    <PropertyGroup>
      <FH2DotNetModsDir Condition="'$(FH2DotNetModsDir)' == ''">$([System.IO.Path]::GetFullPath('$(FH2ModsDir)\..\fh2-mods-dotnet'))</FH2DotNetModsDir>
      <_FH2Dest>$([MSBuild]::EnsureTrailingSlash('$(FH2DotNetModsDir)'))$(AssemblyName)\</_FH2Dest>
    </PropertyGroup>
    <ItemGroup>
      <!-- The SDK assembly comes from the host's own copy, never the mod's; win-x64 is an AOT publish's output. -->
      <_FH2Files Include="$(OutDir)**\*" Exclude="$(OutDir)FH2ModPlatform.*;$(OutDir)win-x64\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_FH2Files)" DestinationFiles="@(_FH2Files->'$(_FH2Dest)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(AssemblyName) -> $(_FH2Dest)" />
  </Target>

  <Target Name="FH2DeployAot" AfterTargets="Publish" Condition="'$(FH2ModsDir)' != '' and '$(FH2ModHosting)' == 'Aot'">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).dll" DestinationFolder="$(FH2ModsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="$(AssemblyName) -> $(FH2ModsDir)" />
    <Warning Condition="Exists('$([System.IO.Path]::GetFullPath('$(FH2ModsDir)\..\fh2-mods-dotnet'))\$(AssemblyName)\$(AssemblyName).dll')"
             Text="$(AssemblyName) is also installed as a hosted mod (fh2-mods-dotnet\$(AssemblyName)\), so it would load twice. Remove that folder (or rename it to $(AssemblyName).disabled) to use this NativeAOT build." />
  </Target>

  <Target Name="FH2WarnHostedTwice" AfterTargets="FH2DeployHosted" Condition="'$(FH2ModsDir)' != '' and '$(FH2ModHosting)' == 'Hosted'">
    <Warning Condition="Exists('$([MSBuild]::EnsureTrailingSlash($(FH2ModsDir)))$(AssemblyName).dll')"
             Text="$(AssemblyName) is also installed as a NativeAOT mod ($(FH2ModsDir)\$(AssemblyName).dll), so it would load twice. Remove that file to use this hosted build." />
  </Target>

  <!-- The Aot configuration: Build makes the native DLL as well (Visual Studio's Build button,
       or dotnet build -c Aot), as publish would. -->
  <Target Name="FH2PublishOnBuild" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Aot' and '$(FH2ModHosting)' == 'Aot' and '$(FH2ModType)' != '' and '$(_IsPublishing)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <CallTarget Targets="Publish" />
  </Target>
</Project>
