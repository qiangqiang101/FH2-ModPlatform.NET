<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>FH2ModPlatform</RootNamespace>

    <!-- Two versions, on purpose:
         Version (0.10.0) is the release: the zip, the package, the tag. Every release bumps it.
         AssemblyVersion is only for the .NET loader. Hosted mods all share the host's copy of
         this assembly, and a mod needs the one it was built against or newer: so a mod built
         against a newer SDK than the one installed fails to load with a clear error, instead of
         crashing on a method that isn't there. Bump its minor (1.2.0.0, 1.3.0.0...) only when
         the public API grows, and never lower it: 0.9.0 shipped 1.0.0.0, so matching the release
         (0.10.0.0) would stop every mod built for 0.9.0 from loading. Players never see it. -->

    <Version>0.10.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>

    <!-- FH2DotNet.dll starts the runtime from this assembly's runtimeconfig.json.
         Major: a player with only a newer .NET runtime can still run mods. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <RollForward>Major</RollForward>

    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>FH2ModPlatform</PackageId>
    <Authors>Bartholomew Ho</Authors>
    <Description>Write Forza Horizon 2 mods for the FH2 Mod Platform in C# or VB.NET, as NativeAOT DLLs or hosted by FH2DotNet.dll.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/qiangqiang101/FH2-ModPlatform.NET</PackageProjectUrl>
    <!-- GitHub Packages links the package to this repo through it (and GITHUB_TOKEN may only publish there). -->
    <RepositoryUrl>https://github.com/qiangqiang101/FH2-ModPlatform.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <!-- NuGet imports build files named after the package into every project that references it. -->
    <None Include="build\FH2ModPlatform.props;build\FH2ModPlatform.targets" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

</Project>
